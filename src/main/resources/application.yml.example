# ============================================================
# MODELO DE CONFIGURAÇÃO
# ============================================================
# Copie este arquivo para:
#   src/main/resources/application.yml
#
# Depois preencha a senha do PostgreSQL e o segredo do JWT.
# O application.yml real está no .gitignore e NÃO vai para o GitHub.
# ============================================================

spring:
  application:
    name: Sistema-bancario

  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5555/Banking_systemDB}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:SUA_SENHA_AQUI}
    driver-class-name: org.postgresql.Driver

  jpa:
    show-sql: false
    hibernate:
      ddl-auto: none
    properties:
      hibernate:
        format_sql: true

  batch:
    jdbc:
      schema: classpath:/table/V7__create_batch_tables.sql
      table-prefix: batch.BATCH_

  kafka:
    bootstrap-servers: localhost:9092
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer

jwt:
  # Gere uma chave Base64 segura, por exemplo com:
  #   openssl rand -base64 32
  secret: ${JWT_SECRET:COLOQUE_UMA_CHAVE_BASE64_DE_32_BYTES_AQUI}
